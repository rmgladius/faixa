<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Faixa</AssemblyName>
    <RootNamespace>Faixa</RootNamespace>
    <ApplicationIcon>Assets\faixa.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Baixa músicas do YouTube em MP3 ou no formato original</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Faixa.Nucleo\Faixa.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\faixa.ico" />
    <Resource Include="Assets\faixa.png" />
  </ItemGroup>

</Project>
