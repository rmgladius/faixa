<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- O código continua no namespace Faixa; o programa se chama RD Track Downloader. -->
    <AssemblyName>RDTrackDownloader</AssemblyName>
    <AssemblyTitle>RD Track Downloader</AssemblyTitle>
    <RootNamespace>Faixa</RootNamespace>
    <ApplicationIcon>Assets\faixa.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Baixa músicas e playlists do YouTube, do SoundCloud, do Spotify e do Deezer</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Faixa.Nucleo\Faixa.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\faixa.ico" />
    <Resource Include="Assets\faixa.png" />
  </ItemGroup>

</Project>
