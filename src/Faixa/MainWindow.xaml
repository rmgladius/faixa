<Window x:Class="Faixa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Faixa.Servicos;assembly=Faixa.Nucleo"
        xmlns:local="clr-namespace:Faixa"
        Title="{x:Static s:Programa.Nome}"
        Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
        FontFamily="{StaticResource Fonte}" FontSize="14"
        Icon="Assets/faixa.ico" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Tarefa" />
    </Window.TaskbarItemInfo>

    <Grid x:Name="Raiz" Background="{StaticResource Fundo}">
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/faixa.png" Width="38" Height="38"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel x:Name="Marca" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Background="Transparent">
                    <TextBlock Text="{x:Static s:Programa.Nome}" FontFamily="{StaticResource FonteTitulo}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="YouTube, SoundCloud, Spotify e Deezer" FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Aparece só quando há versão nova publicada -->
                <Button x:Name="BotaoAtualizar" Grid.Column="2" Style="{StaticResource BotaoNovidade}" Margin="8,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="Atualizar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icones}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock x:Name="BotaoAtualizarTexto" Text="Nova versão" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Sobre: versão, quem fez e contato. Com a etiqueta de versão nova ao lado, fica só o ícone. -->
                <Button x:Name="BotaoSobre" Grid.Column="3" Style="{StaticResource BotaoFantasma}" Margin="4,0,-10,0"
                        VerticalAlignment="Center" Click="Sobre_Click" ToolTip="Sobre o programa e contato">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icones}" FontSize="14" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock x:Name="BotaoSobreTexto" Text="Sobre" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Link -->
            <Border Grid.Row="1" Style="{StaticResource MolduraCampo}" Height="50" Margin="0,20,0,0">
                <Grid Margin="15,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icones}" FontSize="16"
                               Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Margin="11,0,6,0">
                        <TextBlock x:Name="Dica" Text="Cole o link da música ou da playlist" Foreground="{StaticResource TextoApagado}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="CampoLink" Style="{StaticResource CampoLimpo}"
                                 TextChanged="CampoLink_TextChanged" KeyDown="CampoLink_KeyDown" />
                    </Grid>
                    <Button x:Name="BotaoColar" Grid.Column="2" Style="{StaticResource BotaoFantasma}"
                            Click="Colar_Click" ToolTip="Colar o link copiado (Ctrl+V)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icones}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Colar" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoLimpar" Grid.Column="2" Style="{StaticResource BotaoFantasma}"
                            Click="Limpar_Click" ToolTip="Limpar" Visibility="Collapsed" Padding="9,7">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icones}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Cartão: um vídeo (capa, nome, qualidade) ou uma playlist (lista de faixas) -->
            <Border Grid.Row="2" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borda}"
                    BorderThickness="1" CornerRadius="16" Padding="20,20,20,16" Margin="0,14,0,0">
                <Grid>
                    <StackPanel x:Name="PainelVideo">
                        <Grid Width="196" Height="196" HorizontalAlignment="Center">
                            <Grid x:Name="CapaVazia">
                                <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource Superficie2}"
                                           Stroke="{StaticResource BordaForte}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CapaVaziaIcone" Text="&#xEC4F;" FontFamily="{StaticResource Icones}" FontSize="40"
                                               Foreground="{StaticResource TextoApagado}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CapaVaziaTexto" Text="A capa aparece aqui" FontSize="12" Margin="0,12,0,0"
                                               Foreground="{StaticResource TextoApagado}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="Capa" CornerRadius="12" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CapaEscala" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- Música e artista: já limpos, e editáveis com um clique -->
                        <TextBox x:Name="CampoMusica" Style="{StaticResource CampoNome}" Height="48" Margin="0,14,0,0"
                                 FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLength="200"
                                 TextChanged="CampoNome_TextChanged" />
                        <TextBox x:Name="CampoArtista" Style="{StaticResource CampoNome}" Height="24" Margin="0,1,0,0"
                                 FontSize="13" Foreground="{StaticResource TextoSuave}" MaxLength="150"
                                 TextChanged="CampoNome_TextChanged" />
                        <TextBlock x:Name="LinhaOrigem" TextAlignment="Center" FontSize="11" Height="15" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextoApagado}" />

                        <!-- Qualidade real do áudio de origem (YouTube, YouTube Music ou SoundCloud) -->
                        <Border x:Name="Fonte" Height="28" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Background="{StaticResource Superficie2}" CornerRadius="14" Padding="12,0" Visibility="Hidden">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="FonteIcone" Text="&#xE8D6;" FontFamily="{StaticResource Icones}" FontSize="12"
                                           Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock x:Name="FonteTexto" FontSize="12" Foreground="{StaticResource TextoSuave}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Playlist: ocupa exatamente a altura do painel do vídeo -->
                    <Grid x:Name="PainelLista" Visibility="Collapsed" Height="{Binding ActualHeight, ElementName=PainelVideo}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ListaCapa" Width="64" Height="64" CornerRadius="10" Background="{StaticResource Superficie2}">
                                <TextBlock x:Name="ListaCapaIcone" Text="&#xE90B;" FontFamily="{StaticResource Icones}" FontSize="24"
                                           Foreground="{StaticResource TextoApagado}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ListaTipo" Text="PLAYLIST" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource Destaque}" />
                                <TextBlock x:Name="ListaTitulo" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ListaResumo" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,6">
                            <CheckBox x:Name="MarcarTodas" Style="{StaticResource Marcador}" Content="Todas"
                                      Click="MarcarTodas_Click" />
                            <TextBlock x:Name="ListaSelecao" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextoSuave}" />
                        </Grid>
                        <ListBox x:Name="ListaFaixas" Grid.Row="2" Style="{StaticResource ListaLimpa}"
                                 ItemContainerStyle="{StaticResource ItemFaixa}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40" ToolTip="{Binding Detalhe}" Opacity="{Binding Opacidade}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Marcador}" VerticalAlignment="Center"
                                                  IsChecked="{Binding Selecionada, Mode=TwoWay}" IsEnabled="{Binding PodeMarcar}"
                                                  Click="MarcarFaixa_Click" />
                                        <TextBlock Grid.Column="1" Text="{Binding Numero}" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextoApagado}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Musica}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artista}" FontSize="11.5" Margin="0,1,0,0"
                                                       Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                            <TextBlock Text="{Binding Icone}" FontFamily="{StaticResource Icones}" FontSize="12"
                                                       Foreground="{Binding Cor}" VerticalAlignment="Center" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding Situacao}" FontSize="11.5" Foreground="{Binding Cor}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Formato e Baixar -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SeletorFormato" Style="{StaticResource Seletor}"
                          ItemContainerStyle="{StaticResource ItemSeletor}"
                          SelectionChanged="Formato_SelectionChanged" ToolTip="Formato do arquivo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detalhe}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Tamanho}" FontSize="11.5" Margin="12,1,0,0"
                                           Foreground="{StaticResource TextoSuave}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="BotaoBaixar" Grid.Column="2" Style="{StaticResource BotaoPrincipal}"
                        Click="Baixar_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BotaoIcone" Text="&#xE896;" FontFamily="{StaticResource Icones}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,1,10,0" />
                        <TextBlock x:Name="BotaoTexto" Text="Baixar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Progresso e mensagens -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>
                <Border x:Name="Trilho" CornerRadius="3"
                        Background="{StaticResource Superficie2}" ClipToBounds="True" Visibility="Hidden">
                    <Border x:Name="Barra" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                            Background="{StaticResource DestaqueGradiente}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BarraDesloc" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel VerticalAlignment="Top">
                        <TextBlock x:Name="StatusIcone" DockPanel.Dock="Left" FontFamily="{StaticResource Icones}" FontSize="13"
                                   Margin="0,2,8,0" VerticalAlignment="Top" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusTexto" FontSize="13" Foreground="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight" />
                    </DockPanel>
                    <TextBlock x:Name="StatusPercentual" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoSuave}" VerticalAlignment="Top" Margin="12,0,0,0" />
                    <Button x:Name="BotaoAcao" Grid.Column="1" Style="{StaticResource BotaoLink}" Margin="14,0,0,0"
                            VerticalAlignment="Top" Visibility="Collapsed" Click="Acao_Click" />
                </Grid>
            </Grid>

            <!-- Pasta de destino -->
            <Border Grid.Row="5" Margin="0,12,0,0" BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Superficie2}">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icones}" FontSize="15"
                                   Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="PainelPasta" Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Pasta_Click">
                        <TextBlock Text="Salvar em" FontSize="11" Foreground="{StaticResource TextoApagado}" />
                        <TextBlock x:Name="PastaNome" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button x:Name="BotaoAlterar" Grid.Column="2" Style="{StaticResource BotaoFantasma}"
                            Content="Alterar" Click="Alterar_Click" ToolTip="Escolher outra pasta" />
                </Grid>
            </Border>
        </Grid>

        <!-- Sobre: cobre a janela; fecha com Esc, com o X ou com um clique fora do cartão -->
        <Grid x:Name="PainelSobre" Background="#E00B0C10" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="PainelSobre_MouseLeftButtonDown">
            <Border x:Name="CartaoSobre" Margin="22,0" VerticalAlignment="Center" Padding="22,20,22,18"
                    Background="{StaticResource Superficie}" BorderBrush="{StaticResource BordaForte}" BorderThickness="1" CornerRadius="16">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CartaoSobreDesloc" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/faixa.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static s:Programa.Nome}" FontFamily="{StaticResource FonteTitulo}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="SobreVersao" FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource BotaoFantasma}" Padding="9,7" Margin="0,-6,-10,0"
                                VerticalAlignment="Top" Click="FecharSobre_Click" ToolTip="Fechar (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icones}" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Text="Baixa músicas e playlists do YouTube e do SoundCloud. Dos links do Spotify e do Deezer, procura a mesma gravação no YouTube Music." />

                    <Border Height="1" Background="{StaticResource Borda}" Margin="0,18,0,16" />

                    <TextBlock Text="DESENVOLVIDO POR" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Destaque}" />
                    <TextBlock Text="Rodrigo Dias" FontFamily="{StaticResource FonteTitulo}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                    <TextBlock Text="Florianópolis, SC" FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,1,0,0" />

                    <StackPanel Margin="-8,12,-8,0">
                    <Button x:Name="ContatoEmail" Style="{StaticResource LinhaContato}" Click="CopiarEmail_Click" ToolTip="Copiar o e-mail">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Superficie2}">
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource Icones}" FontSize="15"
                                           Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EmailRotulo" Text="E-mail" FontSize="11" Foreground="{StaticResource TextoApagado}" />
                                <TextBlock Text="{x:Static local:Sobre.Email}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE8C8;" FontFamily="{StaticResource Icones}" FontSize="12"
                                       Foreground="{StaticResource TextoApagado}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource LinhaContato}" Click="Endereco_Click" Tag="{x:Static local:Sobre.GitHub}" ToolTip="Abrir no navegador">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Superficie2}">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextoSuave}"
                                      Data="M 8 0 C 3.58 0 0 3.58 0 8 c 0 3.54 2.29 6.53 5.47 7.59 0.4 0.07 0.55 -0.17 0.55 -0.38 0 -0.19 -0.01 -0.82 -0.01 -1.49 -2.01 0.37 -2.53 -0.49 -2.69 -0.94 -0.09 -0.23 -0.48 -0.94 -0.82 -1.13 -0.28 -0.15 -0.68 -0.52 -0.01 -0.53 0.63 -0.01 1.08 0.58 1.23 0.82 0.72 1.21 1.87 0.87 2.33 0.66 0.07 -0.52 0.28 -0.87 0.51 -1.07 -1.78 -0.2 -3.64 -0.89 -3.64 -3.95 0 -0.87 0.31 -1.59 0.82 -2.15 -0.08 -0.2 -0.36 -1.02 0.08 -2.12 0 0 0.67 -0.21 2.2 0.82 0.64 -0.18 1.32 -0.27 2 -0.27 0.68 0 1.36 0.09 2 0.27 1.53 -1.04 2.2 -0.82 2.2 -0.82 0.44 1.1 0.16 1.92 0.08 2.12 0.51 0.56 0.82 1.27 0.82 2.15 0 3.07 -1.87 3.75 -3.65 3.95 0.29 0.25 0.54 0.73 0.54 1.48 0 1.07 -0.01 1.93 -0.01 2.2 0 0.21 0.15 0.46 0.55 0.38 A 8.013 8.013 0 0 0 16 8 c 0 -4.42 -3.58 -8 -8 -8 z" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="GitHub" FontSize="11" Foreground="{StaticResource TextoApagado}" />
                                <TextBlock Text="{x:Static local:Sobre.GitHubTexto}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource Icones}" FontSize="12"
                                       Foreground="{StaticResource TextoApagado}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource LinhaContato}" Click="Endereco_Click" Tag="{x:Static local:Sobre.Instagram}" ToolTip="Abrir no navegador">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Superficie2}">
                                <!-- Câmera do Instagram: moldura arredondada, lente e flash -->
                                <Grid Width="16" Height="16">
                                    <Rectangle RadiusX="4.6" RadiusY="4.6" Stroke="{StaticResource TextoSuave}" StrokeThickness="1.6" />
                                    <Ellipse Width="7" Height="7" Stroke="{StaticResource TextoSuave}" StrokeThickness="1.6" />
                                    <Ellipse Width="2" Height="2" Fill="{StaticResource TextoSuave}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2.6,2.6,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Instagram" FontSize="11" Foreground="{StaticResource TextoApagado}" />
                                <TextBlock Text="{x:Static local:Sobre.InstagramTexto}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource Icones}" FontSize="12"
                                       Foreground="{StaticResource TextoApagado}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Button>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Borda}" Margin="0,12,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BotaoLink}" FontSize="12" Content="Código-fonte"
                                Tag="{x:Static s:Programa.UrlRepositorio}" Click="Endereco_Click" ToolTip="O projeto no GitHub" />
                        <TextBlock Text="·" Margin="9,0" FontSize="12" Foreground="{StaticResource TextoApagado}" />
                        <Button Style="{StaticResource BotaoLink}" FontSize="12" Content="Relatar um problema"
                                Tag="{x:Static local:Sobre.Problemas}" Click="Endereco_Click" ToolTip="Abrir um chamado no GitHub" />
                    </StackPanel>
